{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@slu/web-shell": ["./vendor/web-shell/dist/index.d.ts", "./vendor/web-shell/src/index.ts"],
      "@slu/web-shell/*": ["./vendor/web-shell/dist/*", "./vendor/web-shell/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
